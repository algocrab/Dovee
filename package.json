{
  "name": "dovee",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "productName": "Dovee",
  "author": "Dovee",
  "description": "A local coding IDE with an autonomous agent",
  "scripts": {
    "dev": "next dev --turbopack --port 3100 --hostname 127.0.0.1",
    "predev": "node scripts/sync-monaco.cjs",
    "build": "next build",
    "prebuild": "node scripts/sync-monaco.cjs",
    "start": "next start --port 3100 --hostname 127.0.0.1",
    "desktop": "electron .",
    "desktop:prod": "electron . --prod",
    "lint": "eslint",
    "harness": "dsh web --no-open",
    "harness:open": "dsh web",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "sync:monaco": "node scripts/sync-monaco.cjs",
    "dist": "npm run build && node scripts/prepare-standalone.cjs && npm run icon && electron-builder --win"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.52.2",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.1.6-alpha.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.dovee.ide",
    "productName": "Dovee",
    "copyright": "Copyright © Dovee",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "files": [
      "electron/**/*",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!**/node_modules"
        ]
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dovee"
    },
    "portable": {
      "artifactName": "Dovee-${version}-portable.exe"
    },
    "npmRebuild": false
  }
}
